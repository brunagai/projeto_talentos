# Cole estas variáveis no Vercel (Settings → Environment Variables).
# O arquivo baixado do Vercel vem vazio/incompleto — isso é normal.
# Crie cada linha manualmente (Production).

# ===== Obrigatórias agora (sem RLS) =====
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=service_role_do_supabase
SECRET_KEY=mesmo_valor_forte_do_seu_env_local
AUTH_SECRET=mesmo_valor_do_SECRET_KEY
ENVIRONMENT=production
COOKIE_SECURE=true
TRUST_PROXY=true
CORS_ORIGINS=https://projeto-talentos.vercel.app
AUTH_COOKIE_NAME=access_token

# ===== Frontend =====
# AUTH_SECRET já listado acima (tem que ser igual ao SECRET_KEY)
# NEXT_PUBLIC_API_URL deixe VAZIO no Vercel (o app usa /api)

# ===== Opcional depois (RLS / Fase F) =====
# SUPABASE_ANON_KEY=anon_public_do_supabase
# (se preencher ANON_KEY, SECRET_KEY deve ser o JWT Secret do Supabase)
