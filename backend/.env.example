# Opcional — conexão PostgreSQL direta (não usada pelo backend atual).
# DATABASE_URL=
SUPABASE_URL=
# ATENÇÃO: service_role bypassa RLS. O isolamento multi-tenant depende do
# código da API (organizacao_id / turma_id). Não exponha esta chave ao browser.
# Ver docs/TENANCY_E_SERVICE_ROLE.md
SUPABASE_KEY=
SECRET_KEY=
# development | production
ENVIRONMENT=development
# Em production o default é true (HTTPS). Em development, false.
# COOKIE_SECURE=false
# Origens CORS separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_NAME=access_token
# Limite de upload de planilhas (bytes). Padrão: 10 MB
MAX_UPLOAD_BYTES=10485760
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
