DATABASE_URL=
SUPABASE_URL=
# Use a service_role key no backend para operações server-side (bypass de RLS).
SUPABASE_KEY=
# Opcional: JWT secret do Supabase Auth para validação de tokens externos.
# SUPABASE_JWT_SECRET=
SECRET_KEY=
# development | production — em production, usuários demo não são criados no startup
ENVIRONMENT=development
# Defina true em produção com HTTPS
COOKIE_SECURE=false
# Limite de upload de planilhas (bytes). Padrão: 10 MB
MAX_UPLOAD_BYTES=10485760
