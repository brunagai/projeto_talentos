# Opcional — conexão PostgreSQL direta (não usada pelo backend atual).
# DATABASE_URL=
SUPABASE_URL=
# ATENÇÃO: service_role bypassa RLS. Usado só em login/seed/health/boot.
# Ver docs/TENANCY_E_SERVICE_ROLE.md
SUPABASE_KEY=
# Chave anon — request path com RLS (obrigatória em ENVIRONMENT=production).
# Com ANON_KEY definida, o JWT da sessão deve ser assinado com o JWT Secret
# do projeto Supabase (use o mesmo valor em SECRET_KEY).
# SUPABASE_ANON_KEY=
SECRET_KEY=
# development | production
ENVIRONMENT=development
# Em production o default é true (HTTPS). Em development, false.
# COOKIE_SECURE=false
# Origens CORS separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_NAME=access_token
# Limite de upload de planilhas (bytes). Padrão: 10 MB
MAX_UPLOAD_BYTES=10485760
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit compartilhado entre workers (opcional)
# REDIS_URL=redis://127.0.0.1:6379/0
# Confiar em X-Forwarded-For apenas atrás de proxy conhecido
# TRUST_PROXY=false
# Senhas do seed local (opcional; defaults só em development)
# DEMO_PASSWORD_ADMIN=
# DEMO_PASSWORD_RECRUTADOR=
# DEMO_PASSWORD_MENTOR=
# DEMO_PASSWORD_TALENTO=
